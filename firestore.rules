rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: reviews
    // Document ID: {reviewId} (auto-generated by Firestore SDK or client identifier)
    // Fields:
    //   - name: string (required, 1..100 characters) - Reviewer's name
    //   - rating: number (required, 1.0..5.0) - Numeric rating score
    //   - message: string (required, 5..1000 characters) - Review content
    //   - date: string (required, 1..50 characters) - Human-readable display date
    //   - role: string | null (optional, max 100 characters) - Reviewer's role / profession
    //   - company: string | null (optional, max 100 characters) - Reviewer's organization
    //   - relation: string | null (optional, max 50 characters) - Relationship to portfolio owner
    //   - createdAt: timestamp (optional) - Server creation timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Validate that only allowed fields are present
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that all required fields are present
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate optional string field (omitted, null, or valid string within length bounds)
    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() <= maxLen);
    }

    // Validate createdAt timestamp if present
    function isValidCreatedAt() {
      return !('createdAt' in request.resource.data) ||
             request.resource.data.createdAt is timestamp;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate review document payload for creation
    function isValidReview(data) {
      return hasOnlyAllowedFields(['name', 'rating', 'message', 'date', 'role', 'company', 'relation', 'createdAt']) &&
             hasRequiredFields(['name', 'rating', 'message', 'date']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.rating is number &&
             data.rating >= 1.0 &&
             data.rating <= 5.0 &&
             data.message is string &&
             data.message.size() >= 5 &&
             data.message.size() <= 1000 &&
             data.date is string &&
             data.date.size() > 0 &&
             data.date.size() <= 50 &&
             isValidOptionalString('role', 100) &&
             isValidOptionalString('company', 100) &&
             isValidOptionalString('relation', 50) &&
             isValidCreatedAt();
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Reviews collection: public viewing, validated creation, immutable against updates and deletions
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Anyone can submit a review with strict schema validation
      allow create: if isValidReview(request.resource.data);

      // Deny tampering or deleting existing reviews to protect integrity
      allow update, delete: if false;
    }

    // Default catch-all: deny all reads and writes on any unspecified path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
